                <target>Vertaalbare tabellen (toegestane lijst)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.translate_tables.description" xml:space="preserve">
                <source>Table names, separated by commas or one per line. Empty = allow every localizable table.</source>
                <target>Tabelnamen, gescheiden door komma’s of één per regel. Leeg = elke lokaliseerbare tabel toestaan.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.additional_fields" xml:space="preserve">
