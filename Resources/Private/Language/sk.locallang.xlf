                <target>Zatiaľ žiadne profily.</target>
            </trans-unit>
            <trans-unit id="module.noLlmConfigs" xml:space="preserve">
                <source>No configurations yet.</source>
                <target>Zatiaľ žiadne konfigurácie.</target>
            </trans-unit>
