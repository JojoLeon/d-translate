<xliff version="1.0">
    <file target-language="sl" source-language="en" datatype="plaintext" original="messages" date="2026-07-28T00:00:00Z" product-name="d_translate">
        <header/>
        <body>
            <trans-unit id="about.open" xml:space="preserve">
                <source>About dTRANSLATE</source>
                <target>O dTRANSLATE</target>
            </trans-unit>
            <trans-unit id="about.close" xml:space="preserve">
                <source>Close</source>
                <target>Zapri</target>
            </trans-unit>
            <trans-unit id="about.logoAlt" xml:space="preserve">
                <source>Logo: dreistein medienentwicklung</source>
                <target>Logo: dreistein medienentwicklung</target>
            </trans-unit>
            <trans-unit id="about.claim" xml:space="preserve">
                <source>Modern web development and AI integration for mid-sized businesses.</source>
                <target>Sodoben razvoj spletnih strani in integracija UI za srednje velika podjetja.</target>
            </trans-unit>
            <trans-unit id="about.copyright" xml:space="preserve">
                <source>dTRANSLATE (d_translate) — © 2026 Joachim Dreistein.</source>
                <target>dTRANSLATE (d_translate) — © 2026 Joachim Dreistein.</target>
            </trans-unit>
            <trans-unit id="about.license" xml:space="preserve">
                <source>License: GNU General Public License v2 or later.</source>
                <target>Licenca: GNU General Public License v2 ali novejša.</target>
            </trans-unit>
            <trans-unit id="about.description" xml:space="preserve">
                <source>LLM-based translation for TYPO3: profiles, glossaries, background runs.</source>
                <target>Prevajanje z LLM za TYPO3: profili, glosarji, zagoni v ozadju.</target>
            </trans-unit>
            <trans-unit id="about.more" xml:space="preserve">
                <source>More at</source>
                <target>Več na</target>
            </trans-unit>
            <trans-unit id="module.intro" xml:space="preserve">
                <source>LLM-assisted translation through the DataHandler localize path. Profiles bind a site to an LLM configuration.</source>
                <target>Prevajanje z jezikovnim modelom prek poti localize v DataHandlerju. Profili povežejo spletno mesto s konfiguracijo LLM.</target>
            </trans-unit>
            <trans-unit id="module.translatePage" xml:space="preserve">
                <source>Translate page</source>
                <target>Prevedi stran</target>
            </trans-unit>
            <trans-unit id="module.profile" xml:space="preserve">
                <source>Translation profile</source>
                <target>Prevajalski profil</target>
            </trans-unit>
            <trans-unit id="module.allSites" xml:space="preserve">
                <source>all sites</source>
                <target>vsa spletna mesta</target>
            </trans-unit>
            <trans-unit id="module.targetLanguages" xml:space="preserve">
                <source>Target languages</source>
                <target>Ciljni jeziki</target>
            </trans-unit>
            <trans-unit id="module.records" xml:space="preserve">
                <source>Translatable records (page %s)</source>
                <target>Zapisi za prevod (stran %s)</target>
            </trans-unit>
            <trans-unit id="module.pageItself" xml:space="preserve">
                <source>This page</source>
                <target>Ta stran</target>
            </trans-unit>
            <trans-unit id="module.pageItselfHint" xml:space="preserve">
                <source>The page record — title, slug and SEO metadata — is part of every run and cannot be deselected.</source>
                <target>Zapis strani – naslov, slug in metapodatki SEO – je del vsake izvedbe in ga ni mogoče odkljukati.</target>
            </trans-unit>
            <trans-unit id="module.recordsHint" xml:space="preserve">
                <source>Checked records are translated. An unchecked container skips its whole group; unchecked children of a checked container stay in the source language. IRRE children are translated together with their parent record.</source>
                <target>Označeni zapisi se prevedejo. Neoznačen vsebnik preskoči celotno skupino; neoznačeni podrejeni zapisi označenega vsebnika ostanejo v izvornem jeziku. Podrejeni zapisi IRRE se prevedejo skupaj z nadrejenim zapisom.</target>
            </trans-unit>
            <trans-unit id="module.noRecords" xml:space="preserve">
                <source>No translatable records on this page.</source>
                <target>Na tej strani ni zapisov za prevod.</target>
            </trans-unit>
            <trans-unit id="module.selectAll" xml:space="preserve">
                <source>Select all</source>
                <target>Izberi vse</target>
            </trans-unit>
            <trans-unit id="module.selectNone" xml:space="preserve">
                <source>Deselect all</source>
                <target>Počisti izbor</target>
            </trans-unit>
            <trans-unit id="module.selectPageInTree" xml:space="preserve">
                <source>Please select a page in the page tree on the left.</source>
                <target>Izberite stran v drevesu na levi.</target>
            </trans-unit>
            <trans-unit id="module.submit" xml:space="preserve">
                <source>Translate selection</source>
                <target>Prevedi izbrano</target>
            </trans-unit>
            <trans-unit id="module.publishPage" xml:space="preserve">
                <source>Publish translated page immediately</source>
                <target>Prevedeno stran takoj objavi</target>
            </trans-unit>
            <trans-unit id="module.reload" xml:space="preserve">
                <source>Reload page</source>
                <target>Znova naloži stran</target>
            </trans-unit>
            <trans-unit id="module.profiles" xml:space="preserve">
                <source>Translation profiles</source>
                <target>Prevajalski profili</target>
            </trans-unit>
            <trans-unit id="module.newProfile" xml:space="preserve">
                <source>+ New profile</source>
                <target>+ Nov profil</target>
            </trans-unit>
            <trans-unit id="module.llmConfigs" xml:space="preserve">
                <source>LLM configurations</source>
                <target>Konfiguracije LLM</target>
            </trans-unit>
            <trans-unit id="module.newLlmConfig" xml:space="preserve">
                <source>+ New configuration</source>
                <target>+ Nova konfiguracija</target>
            </trans-unit>
            <trans-unit id="module.noProfiles" xml:space="preserve">
                <source>No profiles yet.</source>
                <target>Profilov še ni.</target>
            </trans-unit>
            <trans-unit id="module.noLlmConfigs" xml:space="preserve">
                <source>No configurations yet.</source>
                <target>Konfiguracij še ni.</target>
            </trans-unit>
            <trans-unit id="module.edit" xml:space="preserve">
                <source>Edit</source>
                <target>Uredi</target>
            </trans-unit>
            <trans-unit id="column.title" xml:space="preserve">
                <source>Title</source>
                <target>Naslov</target>
            </trans-unit>
            <trans-unit id="column.site" xml:space="preserve">
                <source>Site</source>
                <target>Spletno mesto</target>
            </trans-unit>
            <trans-unit id="column.llmConfig" xml:space="preserve">
                <source>LLM config</source>
                <target>Konfiguracija LLM</target>
            </trans-unit>
            <trans-unit id="column.formality" xml:space="preserve">
                <source>Formality</source>
                <target>Raven vikanja</target>
            </trans-unit>
            <trans-unit id="column.tables" xml:space="preserve">
                <source>Tables</source>
                <target>Tabele</target>
            </trans-unit>
            <trans-unit id="column.type" xml:space="preserve">
                <source>Type</source>
                <target>Vrsta</target>
            </trans-unit>
            <trans-unit id="column.model" xml:space="preserve">
                <source>Model</source>
                <target>Model</target>
            </trans-unit>
            <trans-unit id="column.endpoint" xml:space="preserve">
                <source>Endpoint</source>
                <target>Končna točka</target>
            </trans-unit>
            <trans-unit id="js.pageMeta" xml:space="preserve">
                <source>Page metadata</source>
                <target>Metapodatki strani</target>
            </trans-unit>
            <trans-unit id="js.chooseLanguage" xml:space="preserve">
                <source>Please choose at least one target language.</source>
                <target>Izberite vsaj en ciljni jezik.</target>
            </trans-unit>
            <trans-unit id="js.progress" xml:space="preserve">
                <source>Translating %s/%s: %s …</source>
                <target>Prevajanje %s/%s: %s …</target>
            </trans-unit>
            <trans-unit id="js.finished" xml:space="preserve">
                <source>Finished. Reloading page …</source>
                <target>Končano. Stran se znova nalaga …</target>
            </trans-unit>
            <trans-unit id="js.finishedErrors" xml:space="preserve">
                <source>%s chunk(s) with errors — messages stay on screen, please check.</source>
                <target>Sklopov z napakami: %s — sporočila ostanejo na zaslonu, preverite jih.</target>
            </trans-unit>
            <trans-unit id="js.finishedHints" xml:space="preserve">
                <source>Finished, with notices — messages stay on screen, please check.</source>
                <target>Končano, z opozorili — sporočila ostanejo na zaslonu, preverite jih.</target>
            </trans-unit>
            <trans-unit id="js.aborted" xml:space="preserve">
                <source>Run aborted — please check the LLM configuration.</source>
                <target>Zagon prekinjen — preverite konfiguracijo LLM.</target>
            </trans-unit>
            <trans-unit id="js.serverError" xml:space="preserve">
                <source>Server error (HTTP %s).</source>
                <target>Napaka strežnika (HTTP %s).</target>
            </trans-unit>
            <trans-unit id="js.seeLog" xml:space="preserve">
                <source>Details in the TYPO3 log.</source>
                <target>Podrobnosti v dnevniku TYPO3.</target>
            </trans-unit>
            <trans-unit id="js.networkError" xml:space="preserve">
                <source>Network error at %s: %s</source>
                <target>Omrežna napaka pri %s: %s</target>
            </trans-unit>
            <trans-unit id="run.selectPageAndLanguage" xml:space="preserve">
                <source>Please select a page (in the page tree) and at least one target language.</source>
                <target>Izberite stran (v drevesu strani) in vsaj en ciljni jezik.</target>
            </trans-unit>
            <trans-unit id="run.invalidParameters" xml:space="preserve">
                <source>Invalid parameters.</source>
                <target>Neveljavni parametri.</target>
            </trans-unit>
            <trans-unit id="run.subject" xml:space="preserve">
                <source>Page %s → %s</source>
                <target>Stran %s → %s</target>
            </trans-unit>
            <trans-unit id="run.created" xml:space="preserve">
                <source>%s newly translated</source>
                <target>na novo prevedeno: %s</target>
            </trans-unit>
            <trans-unit id="run.updated" xml:space="preserve">
                <source>%s updated</source>
                <target>posodobljeno: %s</target>
            </trans-unit>
            <trans-unit id="run.createdAndUpdated" xml:space="preserve">
                <source>%s new, %s updated</source>
                <target>novih: %s, posodobljeno: %s</target>
            </trans-unit>
            <trans-unit id="run.noChange" xml:space="preserve">
                <source>no change</source>
                <target>brez sprememb</target>
            </trans-unit>
            <trans-unit id="run.pageCreated" xml:space="preserve">
                <source>page translation created</source>
                <target>prevod strani ustvarjen</target>
            </trans-unit>
            <trans-unit id="run.pageUpdated" xml:space="preserve">
                <source>page metadata updated</source>
                <target>metapodatki strani posodobljeni</target>
            </trans-unit>
            <trans-unit id="run.pageUnchanged" xml:space="preserve">
                <source>page unchanged</source>
                <target>stran nespremenjena</target>
            </trans-unit>
            <trans-unit id="run.hints" xml:space="preserve">
                <source>Notices: %s</source>
                <target>Opozorila: %s</target>
            </trans-unit>
            <trans-unit id="run.emptySelection" xml:space="preserve">
                <source>No records to translate (empty selection).</source>
                <target>Ni zapisov za prevod (prazen izbor).</target>
            </trans-unit>
            <trans-unit id="run.failed" xml:space="preserve">
                <source>Translation failed.</source>
                <target>Prevod ni uspel.</target>
            </trans-unit>
            <trans-unit id="run.itemGaveUp" xml:space="preserve">
                <source>Given up after %s attempts — this record kept interrupting the run. The other records were processed.</source>
                <target>Opuščeno po %s poskusih — ta zapis je znova in znova prekinjal zagon. Preostali zapisi so bili obdelani.</target>
            </trans-unit>
            <trans-unit id="run.noProfile" xml:space="preserve">
                <source>No translation profile applies to this page. Assign the site to a profile, or leave a profile's site empty to make it the default.</source>
                <target>Za to stran ne velja noben prevajalski profil. Dodelite spletno mesto profilu ali pustite polje spletnega mesta prazno, da postane privzeti profil.</target>
            </trans-unit>
            <trans-unit id="run.sourceLanguageUnknown" xml:space="preserve">
                <source>The source language could not be determined. Set it in the translation profile, or give the default language of the site a locale.</source>
                <target>Izvornega jezika ni bilo mogoče določiti. Nastavite ga v prevajalskem profilu ali privzetemu jeziku spletnega mesta dodelite lokalizacijo.</target>
            </trans-unit>
            <trans-unit id="run.summary" xml:space="preserve">
                <source>%s re-translated, %s newly created.</source>
                <target>znova prevedeno: %s, na novo ustvarjeno: %s.</target>
            </trans-unit>
            <trans-unit id="run.queued" xml:space="preserve">
                <source>Run #%s queued — %s unit(s) will be processed in the background.</source>
                <target>Zagon #%s je v čakalni vrsti — %s enot bo obdelanih v ozadju.</target>
            </trans-unit>
            <trans-unit id="run.alreadyRunning" xml:space="preserve">
                <source>A run for this page and language is already open (#%s). Please wait for it to finish or cancel it.</source>
                <target>Za to stran in jezik je zagon že odprt (#%s). Počakajte, da se konča, ali ga prekličite.</target>
            </trans-unit>
            <trans-unit id="run.cancelled" xml:space="preserve">
                <source>Run #%s cancelled.</source>
                <target>Zagon #%s preklican.</target>
            </trans-unit>
            <trans-unit id="run.background" xml:space="preserve">
                <source>Process in the background</source>
                <target>Obdelaj v ozadju</target>
            </trans-unit>
            <trans-unit id="run.backgroundHint" xml:space="preserve">
                <source>The run is handled by the server worker — you can close this page.</source>
                <target>Za zagon poskrbi strežniški delavec — to stran lahko zaprete.</target>
            </trans-unit>
            <trans-unit id="run.skipTranslated" xml:space="preserve">
                <source>Skip translated</source>
                <target>Preskoči prevedeno</target>
            </trans-unit>
            <trans-unit id="run.skipTranslatedHint" xml:space="preserve">
                <source>Records that already have a translation are left untouched; only the missing ones are created.</source>
                <target>Zapisi, ki že imajo prevod, ostanejo nedotaknjeni; ustvarijo se samo manjkajoči.</target>
            </trans-unit>
            <trans-unit id="run.estimate" xml:space="preserve">
                <source>This run covers %s unit(s) in %s language(s).</source>
                <target>Ta zagon obsega %s enot v %s jeziku/jezikih.</target>
            </trans-unit>
            <trans-unit id="run.confirmTitle" xml:space="preserve">
                <source>Start this run in the browser?</source>
                <target>Zaženem ta zagon v brskalniku?</target>
            </trans-unit>
            <trans-unit id="run.confirmHint" xml:space="preserve">
                <source>Without "Process in the background" this page has to stay open until the run has finished. Tick that option to hand the run to the server worker instead.</source>
                <target>Brez „Obdelaj v ozadju“ mora ta stran ostati odprta, dokler se zagon ne konča. Označite to možnost, da zagon prevzame strežniški delavec.</target>
            </trans-unit>
            <trans-unit id="run.confirmContinue" xml:space="preserve">
                <source>Start in the browser</source>
                <target>Zaženi v brskalniku</target>
            </trans-unit>
            <trans-unit id="run.confirmCancel" xml:space="preserve">
                <source>Cancel</source>
                <target>Prekliči</target>
            </trans-unit>
            <trans-unit id="run.budgetExceeded" xml:space="preserve">
                <source>Run stopped: the limit of %s LLM calls was reached.</source>
                <target>Zagon ustavljen: dosežena je omejitev %s klicev LLM.</target>
            </trans-unit>
            <trans-unit id="run.jobs" xml:space="preserve">
                <source>Recent runs</source>
                <target>Zadnji zagoni</target>
            </trans-unit>
            <trans-unit id="run.jobState.queued" xml:space="preserve">
                <source>queued</source>
                <target>v vrsti</target>
            </trans-unit>
            <trans-unit id="run.jobState.running" xml:space="preserve">
                <source>running</source>
                <target>poteka</target>
            </trans-unit>
            <trans-unit id="run.jobState.done" xml:space="preserve">
                <source>done</source>
                <target>končano</target>
            </trans-unit>
            <trans-unit id="run.jobState.failed" xml:space="preserve">
                <source>failed</source>
                <target>neuspelo</target>
            </trans-unit>
            <trans-unit id="run.jobState.cancelled" xml:space="preserve">
                <source>cancelled</source>
                <target>preklicano</target>
            </trans-unit>
            <trans-unit id="run.jobProgress" xml:space="preserve">
                <source>%s of %s</source>
                <target>%s od %s</target>
            </trans-unit>
            <trans-unit id="run.jobUsage" xml:space="preserve">
                <source>%s calls · %s tokens</source>
                <target>%s klicev · %s žetonov</target>
            </trans-unit>
            <trans-unit id="run.jobCancel" xml:space="preserve">
                <source>Cancel</source>
                <target>Prekliči</target>
            </trans-unit>
            <trans-unit id="run.noJobs" xml:space="preserve">
                <source>No runs yet.</source>
                <target>Zagonov še ni.</target>
            </trans-unit>
            <trans-unit id="task.work.title" xml:space="preserve">
                <source>dTRANSLATE: Process translation queue</source>
                <target>dTRANSLATE: obdelaj čakalno vrsto prevodov</target>
            </trans-unit>
            <trans-unit id="task.work.description" xml:space="preserve">
                <source>Works off the queued translation runs of the backend module. Schedule it every minute. Alternative to the console command dtranslate:work — use one or the other, not both.</source>
                <target>Obdela prevajalske izvedbe, ki jih je v vrsto uvrstil zaledni modul. Načrtujte ga vsako minuto. Alternativa konzolnemu ukazu dtranslate:work – uporabite eno ali drugo, ne obojega.</target>
            </trans-unit>
            <trans-unit id="js.stepFailed" xml:space="preserve">
                <source>The server did not answer for this unit (HTTP %s) — the run continues with the next one.</source>
                <target>Strežnik za to enoto ni odgovoril (HTTP %s) — zagon se nadaljuje z naslednjo.</target>
            </trans-unit>
            <trans-unit id="js.jobStarted" xml:space="preserve">
                <source>Run #%s started: %s unit(s).</source>
                <target>Zagon #%s se je začel: %s enot.</target>
            </trans-unit>
            <trans-unit id="run.genericError" xml:space="preserve">
                <source>Unexpected error (%s): %s — details in the TYPO3 log.</source>
                <target>Nepričakovana napaka (%s): %s — podrobnosti v dnevniku TYPO3.</target>
            </trans-unit>
            <trans-unit id="field.tooLong" xml:space="preserve">
                <source>%s was left in the source language: the translation is longer than the field allows (%s of %s characters).</source>
                <target>%s je ostalo v izvirnem jeziku: prevod je daljši, kot dovoljuje polje (%s od %s znakov).</target>
            </trans-unit>
            <trans-unit id="llm.noApiKeyConfigured" xml:space="preserve">
                <source>The LLM configuration "%s" has no API key. Please enter one in the configuration.</source>
                <target>Konfiguracija LLM »%s« nima ključa API. Vnesite ga v konfiguraciji.</target>
            </trans-unit>
            <trans-unit id="llm.noApiKey" xml:space="preserve">
                <source>No API key is set for the LLM configuration in use.</source>
                <target>Za uporabljeno konfiguracijo LLM ni nastavljen ključ API.</target>
            </trans-unit>
            <trans-unit id="llm.keyRejected" xml:space="preserve">
                <source>%s rejected the API key (HTTP %s). Please check the key in the LLM configuration and enter it again.</source>
                <target>%s je zavrnil ključ API (HTTP %s). Preverite ključ v konfiguraciji LLM in ga vnesite znova.</target>
            </trans-unit>
            <trans-unit id="llm.unknownModel" xml:space="preserve">
                <source>%s does not know that model or endpoint (HTTP 404). Please check the model name ("%s") and the API base URL (%s).</source>
                <target>%s ne pozna tega modela ali končne točke (HTTP 404). Preverite ime modela (»%s«) in osnovni URL API (%s).</target>
            </trans-unit>
            <trans-unit id="llm.rateLimit" xml:space="preserve">
                <source>%s declined the request because of a rate limit (HTTP 429).</source>
                <target>%s je zavrnil zahtevo zaradi omejitve pogostosti (HTTP 429).</target>
            </trans-unit>
            <trans-unit id="llm.quota" xml:space="preserve">
                <source>The quota of the %s account is used up (HTTP %s). Please check billing and credit.</source>
                <target>Kvota računa %s je porabljena (HTTP %s). Preverite obračun in dobroimetje.</target>
            </trans-unit>
            <trans-unit id="llm.badRequest" xml:space="preserve">
                <source>%s rejected the request (HTTP %s) — usually an unknown model name ("%s") or an unsupported parameter.</source>
                <target>%s je zavrnil zahtevo (HTTP %s) — običajno gre za neznano ime modela (»%s«) ali nepodprt parameter.</target>
            </trans-unit>
            <trans-unit id="llm.serverError" xml:space="preserve">
                <source>%s reports a malfunction (HTTP %s). Please try again later.</source>
                <target>%s javlja motnjo (HTTP %s). Poskusite pozneje.</target>
            </trans-unit>
            <trans-unit id="llm.httpStatus" xml:space="preserve">
                <source>%s answered with HTTP %s.</source>
                <target>%s je odgovoril s HTTP %s.</target>
            </trans-unit>
            <trans-unit id="llm.providerMessage" xml:space="preserve">
                <source>Provider message: %s</source>
                <target>Sporočilo ponudnika: %s</target>
            </trans-unit>
            <trans-unit id="llm.unreachable" xml:space="preserve">
                <source>"%s" cannot be reached. Please check the API base URL of the LLM configuration. (%s)</source>
                <target>»%s« ni dosegljiv. Preverite osnovni URL API v konfiguraciji LLM. (%s)</target>
            </trans-unit>
            <trans-unit id="llm.timeout" xml:space="preserve">
                <source>Timeout on the request to %s — the provider did not answer in time.</source>
                <target>Časovna omejitev zahteve do %s — ponudnik ni odgovoril pravočasno.</target>
            </trans-unit>
            <trans-unit id="llm.connectionFailed" xml:space="preserve">
                <source>Connection to %s failed: %s</source>
                <target>Povezava z %s ni uspela: %s</target>
            </trans-unit>
            <trans-unit id="llm.invalidJson" xml:space="preserve">
                <source>%s did not return valid JSON.</source>
                <target>%s ni vrnil veljavnega JSON.</target>
            </trans-unit>
        </body>
    </file>
</xliff>
