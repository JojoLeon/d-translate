            <trans-unit id="about.claim" xml:space="preserve">
                <source>Modern web development and AI integration for mid-sized businesses.</source>
                <target>Nykyaikaista verkkokehitystä ja tekoälyintegraatioita keskisuurille yrityksille.</target>
            </trans-unit>
            <trans-unit id="about.copyright" xml:space="preserve">
                <source>dTRANSLATE (d_translate) — © 2026 Joachim Dreistein.</source>
