        <body>
            <trans-unit id="tx_dtranslate_llm_config" xml:space="preserve">
                <source>LLM configuration</source>
                <target>LLM-Konfiguration</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.title" xml:space="preserve">
                <source>Title</source>
                <target>Titel</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type" xml:space="preserve">
                <source>Provider type</source>
                <target>Anbietertyp</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type.anthropic" xml:space="preserve">
                <source>Anthropic (Claude)</source>
                <target>Anthropic (Claude)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type.gemini" xml:space="preserve">
                <source>Google (Gemini)</source>
                <target>Google (Gemini)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type.mistral" xml:space="preserve">
                <source>Mistral</source>
                <target>Mistral</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type.openai" xml:space="preserve">
                <source>OpenAI</source>
                <target>OpenAI</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.endpoint" xml:space="preserve">
                <source>API base URL</source>
                <target>API-Basis-URL</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.chat_model" xml:space="preserve">
                <source>Chat model</source>
                <target>Chat-Modell</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.api_key" xml:space="preserve">
                <source>API key</source>
                <target>API-Key</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.api_key.description" xml:space="preserve">
                <source>Provider API key. Stored as entered — it has to be sent to the provider.</source>
                <target>API-Key des Anbieters. Wird unverändert gespeichert — er muss an den Anbieter gesendet werden.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile" xml:space="preserve">
                <source>Translation profile</source>
                <target>Übersetzungsprofil</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.title" xml:space="preserve">
                <source>Title</source>
                <target>Titel</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.site_identifier" xml:space="preserve">
                <source>Sites</source>
                <target>Sites</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.site_identifier.description" xml:space="preserve">
                <source>The TYPO3 sites this profile applies to. None ticked = default profile, used for every site without one of its own.</source>
                <target>Die TYPO3-Sites, für die dieses Profil gilt. Nichts angehakt = Standardprofil, gilt für jede Site ohne eigenes.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.llm_config" xml:space="preserve">
                <source>LLM configuration</source>
                <target>LLM-Konfiguration</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.source_language" xml:space="preserve">
                <source>Source language (override)</source>
                <target>Ausgangssprache (überschreiben)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.source_language.description" xml:space="preserve">
                <source>Only needed when the source texts are not written in the default language of the site. Empty = derive the name from the site locale.</source>
                <target>Nur nötig, wenn die Quelltexte nicht in der Standardsprache der Site verfasst sind. Leer = Name aus der Locale der Site ableiten.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.formality" xml:space="preserve">
                <source>Formality</source>
                <target>Formalität</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.formality.default" xml:space="preserve">
                <source>Default</source>
                <target>Standard</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.formality.formal" xml:space="preserve">
                <source>Formal</source>
                <target>Förmlich (Sie)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.formality.informal" xml:space="preserve">
                <source>Informal</source>
                <target>Vertraulich (du)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.style_hint" xml:space="preserve">
                <source>Style / glossary hint</source>
                <target>Stil- / Glossarhinweis</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.style_hint.description" xml:space="preserve">
                <source>Free-text guidance for the system prompt (tone, brand terms to keep, …).</source>
                <target>Freitext-Vorgabe für den System-Prompt (Tonalität, Markenbegriffe, die bleiben sollen, …).</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.translate_tables" xml:space="preserve">
                <source>Translatable tables (allowlist)</source>
                <target>Übersetzbare Tabellen (Positivliste)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.translate_tables.description" xml:space="preserve">
                <source>Table names, separated by commas or one per line. Empty = allow every localizable table.</source>
                <target>Tabellennamen, getrennt durch Komma oder eine pro Zeile. Leer = alle lokalisierbaren Tabellen erlauben.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.additional_fields" xml:space="preserve">
                <source>Additional fields (table.column)</source>
                <target>Zusätzliche Felder (Tabelle.Spalte)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.additional_fields.description" xml:space="preserve">
                <source>One per line or comma-separated. Text, RTE and FlexForm columns are supported. Standard page SEO fields are translated automatically.</source>
                <target>Eines pro Zeile oder durch Komma getrennt. Text-, RTE- und FlexForm-Spalten werden unterstützt. Die Standard-SEO-Felder von Seiten werden automatisch übersetzt.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.glossary" xml:space="preserve">
                <source>Glossary</source>
                <target>Glossar</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.glossary.description" xml:space="preserve">
                <source>Term pairs injected into the system prompt for consistent terminology.</source>
                <target>Begriffspaare, die für einheitliche Terminologie in den System-Prompt eingefügt werden.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.glossary.hint" xml:space="preserve">
                <source>The entries are managed in Web → Translation → Glossary: a paged list with search and language filter. This form stays quick to open however many terms there are.</source>
                <target>Die Einträge werden unter Web → Übersetzung → Glossar gepflegt: seitenweise, mit Suche und Sprachfilter. Dieses Formular öffnet sich dadurch schnell, egal wie viele Begriffe es gibt.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.glossary.manage" xml:space="preserve">
                <source>Manage glossary (%s entries)</source>
                <target>Glossar verwalten (%s Einträge)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.glossary.saveFirst" xml:space="preserve">
                <source>Save the profile first — its glossary can be filled afterwards.</source>
                <target>Bitte das Profil zuerst speichern — danach lässt sich sein Glossar füllen.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary" xml:space="preserve">
                <source>Glossary entry</source>
                <target>Glossareintrag</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.profile" xml:space="preserve">
                <source>Profile</source>
                <target>Profil</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.profile.description" xml:space="preserve">
                <source>The profile this entry belongs to — or every profile, so one entry serves them all.</source>
                <target>Das Profil, zu dem der Eintrag gehört — oder alle Profile, dann gilt ein Eintrag für alle.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.profile.all" xml:space="preserve">
                <source>Every profile (shared)</source>
                <target>Alle Profile (gemeinsam)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language" xml:space="preserve">
                <source>Applies to</source>
                <target>Gilt für</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language.description" xml:space="preserve">
                <source>A language covers every regional variant and every site that has it; a regional variant or a single site language id narrows it down. The most specific entry wins when several name the same term.</source>
                <target>Eine Sprache deckt alle regionalen Varianten und jede Site ab, die sie hat; eine regionale Variante oder eine einzelne Site-Sprach-ID grenzt ein. Nennen mehrere Einträge denselben Begriff, gewinnt der speziellste.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language.all" xml:space="preserve">
                <source>All target languages</source>
                <target>Alle Zielsprachen</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language.languages" xml:space="preserve">
                <source>Languages (every regional variant)</source>
                <target>Sprachen (alle regionalen Varianten)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language.variants" xml:space="preserve">
                <source>Regional variants</source>
                <target>Regionale Varianten</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language.ids" xml:space="preserve">
                <source>Single site language (id)</source>
                <target>Einzelne Site-Sprache (ID)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.source_term" xml:space="preserve">
                <source>Source term</source>
                <target>Ausgangsbegriff</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_term" xml:space="preserve">
                <source>Target term (translation / keep as is)</source>
                <target>Zielbegriff (Übersetzung / unverändert lassen)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.note" xml:space="preserve">
                <source>Note</source>
                <target>Notiz</target>
            </trans-unit>
            <trans-unit id="tabs.language" xml:space="preserve">
                <source>Language</source>
                <target>Sprache</target>
            </trans-unit>
            <trans-unit id="tabs.glossary" xml:space="preserve">
                <source>Glossary</source>
                <target>Glossar</target>
            </trans-unit>
            <trans-unit id="tabs.scope" xml:space="preserve">
                <source>Scope</source>
                <target>Umfang</target>
            </trans-unit>
            <trans-unit id="tabs.access" xml:space="preserve">
                <source>Access</source>
                <target>Zugriff</target>
            </trans-unit>
        </body>
    </file>
