<xliff version="1.0">
    <file target-language="uk" source-language="en" datatype="plaintext" original="messages" date="2026-07-28T00:00:00Z" product-name="d_translate">
        <header/>
        <body>
            <trans-unit id="tx_dtranslate_llm_config" xml:space="preserve">
                <source>LLM configuration</source>
                <target>Конфігурація LLM</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.title" xml:space="preserve">
                <source>Title</source>
                <target>Назва</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type" xml:space="preserve">
                <source>Provider type</source>
                <target>Тип постачальника</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type.anthropic" xml:space="preserve">
                <source>Anthropic (Claude)</source>
                <target>Anthropic (Claude)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type.gemini" xml:space="preserve">
                <source>Google (Gemini)</source>
                <target>Google (Gemini)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type.mistral" xml:space="preserve">
                <source>Mistral</source>
                <target>Mistral</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.type.openai" xml:space="preserve">
                <source>OpenAI</source>
                <target>OpenAI</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.endpoint" xml:space="preserve">
                <source>API base URL</source>
                <target>Базова URL-адреса API</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.chat_model" xml:space="preserve">
                <source>Chat model</source>
                <target>Модель чату</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.api_key" xml:space="preserve">
                <source>API key</source>
                <target>Ключ API</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_llm_config.api_key.description" xml:space="preserve">
                <source>Provider API key. Stored as entered — it has to be sent to the provider.</source>
                <target>Ключ API постачальника. Зберігається без змін — його потрібно надсилати постачальнику.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile" xml:space="preserve">
                <source>Translation profile</source>
                <target>Профіль перекладу</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.title" xml:space="preserve">
                <source>Title</source>
                <target>Назва</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.site_identifier" xml:space="preserve">
                <source>Site identifier</source>
                <target>Ідентифікатор сайту</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.site_identifier.description" xml:space="preserve">
                <source>The TYPO3 site this profile applies to. Empty = default profile, used for every site without one of its own.</source>
                <target>Сайт TYPO3, до якого належить цей профіль. Порожньо = типовий профіль, застосовується до всіх сайтів без власного.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.site_identifier.all" xml:space="preserve">
                <source>[all sites — default profile]</source>
                <target>[усі сайти — типовий профіль]</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.llm_config" xml:space="preserve">
                <source>LLM configuration</source>
                <target>Конфігурація LLM</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.source_language" xml:space="preserve">
                <source>Source language (override)</source>
                <target>Мова оригіналу (перевизначити)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.source_language.description" xml:space="preserve">
                <source>Only needed when the source texts are not written in the default language of the site. Empty = derive the name from the site locale.</source>
                <target>Потрібно лише тоді, коли вихідні тексти написані не типовою мовою сайту. Порожньо = визначити назву за локаллю сайту.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.formality" xml:space="preserve">
                <source>Formality</source>
                <target>Стиль звертання</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.formality.default" xml:space="preserve">
                <source>Default</source>
                <target>За умовчанням</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.formality.formal" xml:space="preserve">
                <source>Formal</source>
                <target>Офіційний (на «ви»)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.formality.informal" xml:space="preserve">
                <source>Informal</source>
                <target>Неофіційний (на «ти»)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.style_hint" xml:space="preserve">
                <source>Style / glossary hint</source>
                <target>Підказка щодо стилю / глосарію</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.style_hint.description" xml:space="preserve">
                <source>Free-text guidance for the system prompt (tone, brand terms to keep, …).</source>
                <target>Довільний текст для системного промпту (тон, назви брендів, які слід зберегти, …).</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.translate_tables" xml:space="preserve">
                <source>Translatable tables (allowlist)</source>
                <target>Таблиці для перекладу (білий список)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.translate_tables.description" xml:space="preserve">
                <source>Table names, separated by commas or one per line. Empty = allow every localizable table.</source>
                <target>Назви таблиць через кому або по одній у рядку. Порожньо = дозволити будь-яку локалізовувану таблицю.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.additional_fields" xml:space="preserve">
                <source>Additional fields (table.column)</source>
                <target>Додаткові поля (таблиця.колонка)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.additional_fields.description" xml:space="preserve">
                <source>One per line or comma-separated. Text, RTE and FlexForm columns are supported. Standard page SEO fields are translated automatically.</source>
                <target>По одному в рядку або через кому. Підтримуються текстові, RTE- та FlexForm-колонки. Стандартні SEO-поля сторінок перекладаються автоматично.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.glossary" xml:space="preserve">
                <source>Glossary</source>
                <target>Глосарій</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_profile.glossary.description" xml:space="preserve">
                <source>Term pairs injected into the system prompt for consistent terminology.</source>
                <target>Пари термінів, які додаються до системного промпту для узгодженої термінології.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary" xml:space="preserve">
                <source>Glossary entry</source>
                <target>Запис глосарію</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language" xml:space="preserve">
                <source>Applies to target language</source>
                <target>Стосується цільової мови</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language.description" xml:space="preserve">
                <source>Restrict this term to a single language of a site, or let it apply to every target language.</source>
                <target>Обмежує термін однією мовою сайту або залишає його чинним для всіх цільових мов.</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language.all" xml:space="preserve">
                <source>All target languages</source>
                <target>Усі цільові мови</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.source_term" xml:space="preserve">
                <source>Source term</source>
                <target>Термін оригіналу</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_term" xml:space="preserve">
                <source>Target term (translation / keep as is)</source>
                <target>Цільовий термін (переклад / залишити без змін)</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.note" xml:space="preserve">
                <source>Note</source>
                <target>Примітка</target>
            </trans-unit>
            <trans-unit id="tabs.language" xml:space="preserve">
                <source>Language</source>
                <target>Мова</target>
            </trans-unit>
            <trans-unit id="tabs.glossary" xml:space="preserve">
                <source>Glossary</source>
                <target>Глосарій</target>
            </trans-unit>
            <trans-unit id="tabs.scope" xml:space="preserve">
                <source>Scope</source>
                <target>Обсяг</target>
            </trans-unit>
            <trans-unit id="tabs.access" xml:space="preserve">
                <source>Access</source>
                <target>Доступ</target>
            </trans-unit>
        </body>
    </file>
