            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language" xml:space="preserve">
                <source>Applies to</source>
                <target>Aplica-se ao idioma de destino</target>
            </trans-unit>
            <trans-unit id="tx_dtranslate_glossary.target_language.description" xml:space="preserve">
                <source>A language covers every regional variant and every site that has it; a regional variant or a single site language id narrows it down. The most specific entry wins when several name the same term.</source>
                <target>Limita o termo a um único idioma de um site, ou deixa-o valer para todos os idiomas de destino.</target>
            </trans-unit>
